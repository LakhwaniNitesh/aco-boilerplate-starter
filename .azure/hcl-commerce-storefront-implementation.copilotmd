## 🛠️ Implementation Details

### Phase 1: Create HCL Cart API Utility Module

**File:** `scripts/hcl-cart-api.js`

```javascript
/**
 * HCL Cart API utilities for storefront integration
 * Provides methods to interact with HCL Commerce cart via Adobe I/O Runtime
 */

const HCL_API_BASE = process.env.HCL_API_BASE || '/api/hcl';

// Cart data cache (in-memory, cleared on page reload)
let cartCache = null;
let cartCacheTime = 0;
const CACHE_DURATION = 2000; // 2 seconds

/**
 * Add product to HCL cart
 * @param {string} partNumber - Product part number (e.g., "CLA022_220601")
 * @param {number} quantity - Quantity to add
 * @param {string} productName - Optional product name for display
 * @returns {Promise<Object>} Response with orderId, orderItem, cartTotals
 */
export async function addToHclCart(partNumber, quantity = 1, productName = '') {
  try {
    const response = await fetch(`${HCL_API_BASE}/cart/add`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        partNumber,
        quantity,
        productName,
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || 'Failed to add item to cart');
    }

    // Clear cache on successful add
    cartCache = null;

    return data;
  } catch (error) {
    console.error('Error adding to HCL cart:', error);
    throw error;
  }
}

/**
 * Get current cart from HCL
 * @param {boolean} bypassCache - Force fresh fetch, ignore cache
 * @returns {Promise<Object>} Cart data with items and totals
 */
export async function getHclCart(bypassCache = false) {
  // Return cached data if available and not expired
  if (!bypassCache && cartCache && Date.now() - cartCacheTime < CACHE_DURATION) {
    return cartCache;
  }

  try {
    const response = await fetch(`${HCL_API_BASE}/cart`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
      },
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || 'Failed to get cart');
    }

    // Cache the result
    cartCache = data;
    cartCacheTime = Date.now();

    return data;
  } catch (error) {
    console.error('Error fetching HCL cart:', error);
    throw error;
  }
}

/**
 * Remove item from HCL cart
 * @param {string} orderItemId - Order item ID to remove
 * @returns {Promise<Object>} Updated cart totals
 */
export async function removeFromHclCart(orderItemId) {
  try {
    const response = await fetch(`${HCL_API_BASE}/cart/remove`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        orderItemId,
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || 'Failed to remove item from cart');
    }

    // Clear cache on successful remove
    cartCache = null;

    return data;
  } catch (error) {
    console.error('Error removing from HCL cart:', error);
    throw error;
  }
}

/**
 * Clear cart cache (useful after major changes)
 */
export function clearCartCache() {
  cartCache = null;
  cartCacheTime = 0;
}

/**
 * Format price for display
 * @param {string|number} price - Price value
 * @returns {string} Formatted price (e.g., "$45.00")
 */
export function formatPrice(price) {
  const amount = typeof price === 'string' ? parseFloat(price) : price;
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
  }).format(amount);
}

/**
 * Emit custom event for cart updates (for cross-component communication)
 * @param {string} eventName - Event name (e.g., 'cartUpdated')
 * @param {Object} detail - Event detail data
 */
export function emitCartEvent(eventName, detail) {
  const event = new CustomEvent(`hcl:${eventName}`, { detail });
  document.dispatchEvent(event);
}

/**
 * Listen for cart updates
 * @param {string} eventName - Event name to listen for
 * @param {Function} callback - Callback function
 */
export function onCartEvent(eventName, callback) {
  const listener = (event) => callback(event.detail);
  document.addEventListener(`hcl:${eventName}`, listener);

  // Return unsubscribe function
  return () => {
    document.removeEventListener(`hcl:${eventName}`, listener);
  };
}
```

