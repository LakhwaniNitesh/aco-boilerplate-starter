### Phase 2: Modify Product Details Block

**File:** `blocks/product-details/product-details.js`

**Key Changes:**
1. Import HCL cart utilities
2. Intercept "Add to Cart" button click
3. Call HCL API
4. Show feedback to user
5. Update mini-cart

```javascript
// Add imports at top
import { addToHclCart, emitCartEvent } from '../../scripts/hcl-cart-api.js';

// In the decorate function, after ProductHeader is rendered:

// Find or override the Add to Cart button
const addToCartButton = fragment.querySelector('.product-details__buttons__add-to-cart');

// Override the button click handler
addToCartButton.addEventListener('click', async (e) => {
  e.preventDefault();
  
  // Get product data from page
  const productData = events.lastPayload('pdp/data');
  const partNumber = getPartNumberFromPage(); // Extract from PDP data
  const productName = getProductNameFromPage(); // Extract from title
  const quantity = getQuantityFromInput(); // Get quantity from UI
  
  // Show loading state
  addToCartButton.disabled = true;
  addToCartButton.textContent = 'Adding to Cart...';
  
  try {
    // Call HCL Add to Cart API
    const response = await addToHclCart(partNumber, quantity, productName);
    
    if (response.success) {
      // Show success message
      showSuccessAlert('Product added to cart!');
      
      // Emit event for mini-cart to listen
      emitCartEvent('itemAdded', {
        orderId: response.orderId,
        itemCount: response.cartTotals.itemCount,
        cartTotal: response.cartTotals.grandTotal,
      });
      
      // Optional: Redirect to cart or show mini-cart
      // window.location.href = '/cart';
    } else {
      showErrorAlert(response.message || 'Failed to add item');
    }
  } catch (error) {
    showErrorAlert(error.message || 'Error adding to cart');
  } finally {
    addToCartButton.disabled = false;
    addToCartButton.textContent = 'Add to Cart';
  }
});
```

