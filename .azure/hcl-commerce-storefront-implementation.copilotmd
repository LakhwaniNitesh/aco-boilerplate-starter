### Phase 3: Create Mini-Cart Component

**File:** `blocks/commerce-mini-cart/commerce-mini-cart.js`

```javascript
/**
 * Commerce Mini-Cart Block
 * Displays cart summary in header showing items and totals
 * Syncs with HCL Commerce cart
 */

import { getHclCart, onCartEvent, formatPrice } from '../../scripts/hcl-cart-api.js';

export default async function decorate(block) {
  // Create mini-cart structure
  const miniCartHTML = `
    <div class="commerce-mini-cart">
      <button class="commerce-mini-cart__toggle" aria-label="Toggle cart menu">
        <span class="commerce-mini-cart__icon">🛒</span>
        <span class="commerce-mini-cart__badge">0</span>
      </button>
      
      <div class="commerce-mini-cart__dropdown" aria-hidden="true">
        <div class="commerce-mini-cart__header">
          <h3>Shopping Cart</h3>
          <button class="commerce-mini-cart__close" aria-label="Close cart">✕</button>
        </div>
        
        <div class="commerce-mini-cart__items"></div>
        
        <div class="commerce-mini-cart__footer">
          <div class="commerce-mini-cart__totals">
            <p><strong>Subtotal:</strong> <span class="commerce-mini-cart__subtotal">$0.00</span></p>
            <p><strong>Total:</strong> <span class="commerce-mini-cart__total">$0.00</span></p>
          </div>
          <a href="/cart" class="commerce-mini-cart__view-cart-btn">View Cart</a>
          <a href="/checkout" class="commerce-mini-cart__checkout-btn">Checkout</a>
        </div>
      </div>
    </div>
  `;

  const fragment = document.createRange().createContextualFragment(miniCartHTML);
  block.replaceChildren(fragment);

  // Get references
  const toggle = block.querySelector('.commerce-mini-cart__toggle');
  const dropdown = block.querySelector('.commerce-mini-cart__dropdown');
  const closeBtn = block.querySelector('.commerce-mini-cart__close');
  const itemsContainer = block.querySelector('.commerce-mini-cart__items');

  // Toggle dropdown
  toggle.addEventListener('click', () => {
    dropdown.toggleAttribute('aria-hidden');
  });

  closeBtn.addEventListener('click', () => {
    dropdown.setAttribute('aria-hidden', 'true');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!block.contains(e.target)) {
      dropdown.setAttribute('aria-hidden', 'true');
    }
  });

  // Initial cart load
  await updateMiniCart();

  // Listen for cart updates
  onCartEvent('itemAdded', () => updateMiniCart());
  onCartEvent('itemRemoved', () => updateMiniCart());

  // Update mini-cart display
  async function updateMiniCart() {
    try {
      const cartData = await getHclCart();

      if (!cartData.success || !cartData.items || cartData.items.length === 0) {
        itemsContainer.innerHTML = '<p class="commerce-mini-cart__empty">Cart is empty</p>';
        block.querySelector('.commerce-mini-cart__badge').textContent = '0';
        block.querySelector('.commerce-mini-cart__subtotal').textContent = '$0.00';
        block.querySelector('.commerce-mini-cart__total').textContent = '$0.00';
        return;
      }

      // Update badge
      block.querySelector('.commerce-mini-cart__badge').textContent = cartData.cartTotals.itemCount;

      // Render items
      itemsContainer.innerHTML = cartData.items
        .map(
          (item) => `
        <div class="commerce-mini-cart__item">
          <div class="commerce-mini-cart__item-info">
            <p class="commerce-mini-cart__item-name">${item.productName}</p>
            <p class="commerce-mini-cart__item-qty">Qty: ${item.quantity}</p>
            <p class="commerce-mini-cart__item-price">${formatPrice(item.orderItemPrice)}</p>
          </div>
          <button 
            class="commerce-mini-cart__item-remove" 
            data-order-item-id="${item.orderItemId}"
            aria-label="Remove item"
          >
            ✕
          </button>
        </div>
      `
        )
        .join('');

      // Add remove handlers
      itemsContainer.querySelectorAll('.commerce-mini-cart__item-remove').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderItemId = btn.dataset.orderItemId;
          // TODO: Call removeFromHclCart(orderItemId)
          await updateMiniCart();
        });
      });

      // Update totals
      block.querySelector('.commerce-mini-cart__subtotal').textContent = formatPrice(
        cartData.cartTotals.subtotal
      );
      block.querySelector('.commerce-mini-cart__total').textContent = formatPrice(
        cartData.cartTotals.grandTotal
      );
    } catch (error) {
      console.error('Error updating mini-cart:', error);
      itemsContainer.innerHTML = '<p class="commerce-mini-cart__error">Error loading cart</p>';
    }
  }
}
```

