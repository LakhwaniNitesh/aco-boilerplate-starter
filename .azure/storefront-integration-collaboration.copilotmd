  // Call Integration API
  const response = await fetch('/api/hcl/cart/add', {
    method: 'POST',
    body: JSON.stringify({
      productId,
      quantity,
      productName
    })
  });
  
  if (response.ok) {
    // Show success message
    // Update mini-cart in header
    // Maybe redirect to cart or show confirmation
  } else {
    // Show error message (out of stock, not found, etc.)
  }
});
```

