#!/bin/bash
# HCL Commerce Integration - Environment Configuration
# 
# Copy this file to .env.local and update with your values
# Source: scripts/hcl-commerce-api.js
#
# IMPORTANT: Never commit .env.local to git
# Add to .gitignore

# HCL Commerce API Configuration
HCL_API_HOST=20.40.52.251
HCL_STORE_ID=715842834
HCL_LANG_ID=1
HCL_PROTOCOL=https

# Development Configuration
NODE_ENV=development

# Enable Debug Logging
HCL_DEBUG=false

# CORS Configuration (for production)
CORS_ALLOWED_ORIGINS=https://main--aco-boilerplate-starter--lakhwaninitesh.aem.page

# Session Configuration
SESSION_TIMEOUT_MS=3600000

# Checkout Configuration
CHECKOUT_ENABLED=true
GUEST_CHECKOUT_ENABLED=true
AUTHENTICATED_CHECKOUT_ENABLED=true

# Optional: Integration with Adobe I/O Runtime (future)
# IO_RUNTIME_HOST=
# IO_RUNTIME_ACTION=commerce/hcl-cart-handler
# IO_RUNTIME_API_KEY=

# Optional: Analytics & Monitoring (future)
# ANALYTICS_ENABLED=false
# ROLLBAR_TOKEN=
# DATADOG_API_KEY=
