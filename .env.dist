# HCL Commerce Backend Proxy Configuration
# This is a template file. Copy to .env and fill in actual values.
# CRITICAL: Never commit .env to version control!

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Configuration - Frontend Origin
CORS_ORIGIN=http://localhost:3000

# HCL Commerce API Configuration
# Host: The HCL Commerce server address (example: https://20.40.52.251)
HCL_HOST=https://20.40.52.251

# Store ID: The numeric store identifier in HCL
HCL_STORE_ID=715842834

# Authentication Credentials
# SECURITY WARNING: Use staging credentials only for development
# For production, use proper credential management system (AWS Secrets, HashiCorp Vault, etc.)
HCL_AUTH_USERNAME=auroraadobetest
HCL_AUTH_PASSWORD=passw0rd

# Optional: Catalog ID (defaults to 10001 if not specified)
HCL_CATALOG_ID=10001

# Logging
LOG_LEVEL=info
